[Unit]
Description=SuPi-8 Service
After=local-fs.target network.target
Wants=network.target

[Service]
Type=simple
KillSignal=SIGTERM
TimeoutStopSec=5

User=supi
Group=supi

WorkingDirectory=/opt/supi

ExecStart=/usr/bin/python3 -u /opt/supi/worker/supi-8.py

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
